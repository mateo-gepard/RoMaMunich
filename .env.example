# ====================================
# RoMa Munich – Environment Variables
# ====================================

# Database (PostgreSQL)
# ------------------------------------
# Development (Docker):
DATABASE_URL="postgresql://roma:roma2024@localhost:5432/roma_munich"

# Production (Railway/Supabase):
# DATABASE_URL="postgresql://user:password@host:port/database"


# Authentication (NextAuth.js)
# ------------------------------------
NEXTAUTH_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-key-here-min-32-characters-long"


# Payments (Stripe)
# ------------------------------------
# Get from: https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."

# Get from: https://dashboard.stripe.com/test/webhooks
STRIPE_WEBHOOK_SECRET="whsec_..."


# Email (Nodemailer)
# ------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAIL_FROM="RoMa Munich <noreply@roma-munich.de>"

# Gmail App Password Guide:
# https://support.google.com/accounts/answer/185833


# Application
# ------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Production:
# NEXT_PUBLIC_APP_URL="https://roma-munich.de"


# Optional: Analytics & Monitoring
# ------------------------------------
# SENTRY_DSN=""
# PLAUSIBLE_DOMAIN="roma-munich.de"
