// Prisma Schema für RoMa Munich Platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// User Management
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  role          UserRole  @default(STUDENT)
  firstName     String
  lastName      String
  phone         String?
  language      Language  @default(DE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  studentProfile  Student?
  tutorProfile    Tutor?
  bookings        Booking[]
  reviews         Review[]
  messages        Message[]
}

enum UserRole {
  STUDENT
  PARENT
  TUTOR
  ADMIN
}

enum Language {
  DE
  EN
}

// Tutor Profiles
model Tutor {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  bio             String
  bioEn           String?
  age             Int
  profileImage    String?
  hourlyRate      Float
  maxHoursPerWeek Int       @default(5)
  
  // Academic Achievements
  achievements    Achievement[]
  earlyStudy      EarlyStudy?
  
  // Availability
  subjects        TutorSubject[]
  availability    Availability[]
  
  // Stats
  totalHours      Int       @default(0)
  rating          Float     @default(0.0)
  reviewCount     Int       @default(0)
  
  bookings        Booking[]
  reviews         Review[]
  
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Achievement {
  id          String    @id @default(cuid())
  tutorId     String
  tutor       Tutor     @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  
  type        AchievementType
  title       String
  titleEn     String?
  description String?
  year        Int
  rank        String?   // "1. Preis", "Gold", etc.
  
  createdAt   DateTime  @default(now())
}

enum AchievementType {
  MATH_OLYMPIAD
  PHYSICS_OLYMPIAD
  CHEMISTRY_OLYMPIAD
  INFORMATICS_OLYMPIAD
  JUGEND_FORSCHT
  ROBOTICS
  OTHER_COMPETITION
}

model EarlyStudy {
  id          String    @id @default(cuid())
  tutorId     String    @unique
  tutor       Tutor     @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  
  university  University
  field       String
  startYear   Int
  
  createdAt   DateTime  @default(now())
}

enum University {
  LMU
  TUM
  OTHER
}

model TutorSubject {
  id          String    @id @default(cuid())
  tutorId     String
  tutor       Tutor     @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  
  subject     Subject
  level       Level[]
  
  createdAt   DateTime  @default(now())
  
  @@unique([tutorId, subject])
}

enum Subject {
  MATHEMATICS
  PHYSICS
  CHEMISTRY
  BIOLOGY
  COMPUTER_SCIENCE
  ENGLISH
  GERMAN
  FRENCH
  LATIN
  ECONOMICS
}

enum Level {
  MIDDLE_SCHOOL
  GYMNASIUM
  ABITUR
  IB
  COMPETITION
  UNIVERSITY
}

model Availability {
  id          String    @id @default(cuid())
  tutorId     String
  tutor       Tutor     @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  
  dayOfWeek   Int       // 0 = Sunday, 1 = Monday, etc.
  startTime   String    // "14:00"
  endTime     String    // "18:00"
  
  createdAt   DateTime  @default(now())
}

// Student Profiles
model Student {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  age             Int?
  schoolType      SchoolType?
  grade           Int?
  goals           String?
  learningStyle   LearningStyle?
  
  learningPlans   LearningPlan[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum SchoolType {
  GRUNDSCHULE
  REALSCHULE
  GYMNASIUM
  INTERNATIONAL_SCHOOL
  PRIVATE_SCHOOL
}

enum LearningStyle {
  VISUAL
  AUDITORY
  KINESTHETIC
  READING_WRITING
}

// Booking System
model Booking {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  tutorId         String
  tutor           Tutor         @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  
  subject         Subject
  date            DateTime
  startTime       String
  endTime         String
  durationHours   Float
  
  status          BookingStatus @default(PENDING)
  price           Float
  paymentStatus   PaymentStatus @default(PENDING)
  stripeSessionId String?
  
  notes           String?
  sessionSummary  String?       // Nach Session vom Tutor ausgefüllt
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

// Learning Plans & Progress Tracking
model LearningPlan {
  id          String    @id @default(cuid())
  studentId   String
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  
  subject     Subject
  goal        String
  startDate   DateTime
  targetDate  DateTime?
  
  topics      Topic[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Topic {
  id            String       @id @default(cuid())
  planId        String
  plan          LearningPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  
  title         String
  description   String?
  status        TopicStatus  @default(NOT_STARTED)
  completedAt   DateTime?
  
  order         Int          @default(0)
  
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

enum TopicStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NEEDS_REVIEW
}

// Reviews & Testimonials
model Review {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tutorId     String
  tutor       Tutor     @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  
  rating      Int       // 1-5
  comment     String?
  isPublic    Boolean   @default(false)
  
  createdAt   DateTime  @default(now())
}

// Messaging System
model Message {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation(fields: [senderId], references: [id], onDelete: Cascade)
  
  recipientId String
  subject     String?
  content     String
  isRead      Boolean   @default(false)
  
  createdAt   DateTime  @default(now())
}

// Matching Quiz Results
model MatchingQuiz {
  id            String    @id @default(cuid())
  email         String
  
  subject       Subject
  level         Level
  goal          String
  learningStyle LearningStyle?
  urgency       Urgency
  language      Language
  
  matchedTutorId String?
  
  createdAt     DateTime  @default(now())
}

enum Urgency {
  IMMEDIATE
  WITHIN_WEEK
  WITHIN_MONTH
  FLEXIBLE
}
